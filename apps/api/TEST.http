# UPSC VMS — REST Client Test File
# Install "REST Client" extension in VS Code, then click "Send Request" above each block.
# Replace placeholder values (YOUR_TOKEN, UUIDs) with actual values from prior responses.

@base = http://localhost:3001
@token = YOUR_JWT_TOKEN_HERE

# ─────────────────────────────────────────────
# MOD-01: AUTH
# ─────────────────────────────────────────────

### Health check
GET {{base}}/api/health

###

### Request OTP (replace email with a seeded user's email)
POST {{base}}/api/auth/request-otp
Content-Type: application/json

{
  "email": "aso@upsc.gov.in"
}

###

### Verify OTP and get token (replace otp with value from server console log)
# @name login
POST {{base}}/api/auth/verify-otp
Content-Type: application/json

{
  "email": "aso@upsc.gov.in",
  "otp": "123456"
}

###

### Get current user (requires token)
GET {{base}}/api/me
Authorization: Bearer {{token}}

###

### Logout
POST {{base}}/api/auth/logout
Authorization: Bearer {{token}}

# ─────────────────────────────────────────────
# MOD-02: EXAM CREATION AND CENTRE MANAGEMENT
# ─────────────────────────────────────────────

### Create exam (ASO or SO role)
# @name createExam
POST {{base}}/api/exams
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Civil Services Preliminary Examination 2025",
  "year": 2025,
  "examType": "PRELIMINARY",
  "scheduledDate": "2025-05-25T09:00:00.000Z",
  "sessions": 2,
  "session1Start": "09:30",
  "session1End": "11:30",
  "session2Start": "14:30",
  "session2End": "16:30",
  "cities": ["Delhi NCR", "Mumbai", "Chennai", "Kolkata", "Hyderabad", "Bengaluru", "Jaipur"]
}

###

### List all exams (ASO, SO, US, DS, JS)
GET {{base}}/api/exams
Authorization: Bearer {{token}}

###

### Get single exam (replace EXAM_ID)
@examId = EXAM_ID_HERE
GET {{base}}/api/exams/{{examId}}
Authorization: Bearer {{token}}

###

### Release exam — sets status RELEASED, marks all centres released (US role only)
PATCH {{base}}/api/exams/{{examId}}/release
Authorization: Bearer {{token}}

###

### Update centre final capacity (SO or US role)
@centreId = CENTRE_ID_HERE
PATCH {{base}}/api/exams/{{examId}}/centre/{{centreId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "finalCapacity": 120000
}

# ─────────────────────────────────────────────
# MOD-03: VENUE IDENTIFICATION AND SELECTION
# ─────────────────────────────────────────────

### Add venue to bank (CS, SO, or US role)
# @name createVenue
POST {{base}}/api/venues
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Kendriya Vidyalaya No. 1",
  "address": "Sector 8, RK Puram, New Delhi 110022",
  "cityName": "Delhi NCR",
  "type": "GOVERNMENT",
  "capacity": 500
}

###

### List all venues
GET {{base}}/api/venues
Authorization: Bearer {{token}}

###

### List venues filtered by city
GET {{base}}/api/venues?cityName=Delhi%20NCR
Authorization: Bearer {{token}}

###

### CS assigns a venue (and optional VS) to an exam
@venueId = VENUE_ID_HERE
@vsUserId = VS_USER_ID_HERE
POST {{base}}/api/exams/{{examId}}/assignments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "venueId": "{{venueId}}",
  "vsId": "{{vsUserId}}"
}

###

### List all assignments for an exam
GET {{base}}/api/exams/{{examId}}/assignments
Authorization: Bearer {{token}}

###

### Update assignment status (SO sets SO_REVIEWED; US sets APPROVED or REJECTED)
@assignmentId = ASSIGNMENT_ID_HERE
PATCH {{base}}/api/exams/{{examId}}/assignments/{{assignmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "SO_REVIEWED"
}

###

### CS submits all PROPOSED assignments for UPSC review
POST {{base}}/api/exams/{{examId}}/assignments/submit
Authorization: Bearer {{token}}

# ─────────────────────────────────────────────
# MOD-04: ADMINISTRATIVE APPROVAL AND WORKFLOW
# ─────────────────────────────────────────────

### Create approval request (ASO or SO role)
# @name createApproval
POST {{base}}/api/approvals
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "examId": "{{examId}}",
  "type": "VENUE_LIST",
  "currentRole": "US",
  "dueAt": "2025-05-01T17:00:00.000Z"
}

###

### List approvals filtered to current user's role
GET {{base}}/api/approvals
Authorization: Bearer {{token}}

###

### Take action on approval (SO, US, DS, or JS role)
@approvalId = APPROVAL_ID_HERE
PATCH {{base}}/api/approvals/{{approvalId}}/action
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "action": "APPROVE",
  "remarks": "Venue list reviewed and approved. All centres meet capacity requirements."
}

###

### Reject approval
PATCH {{base}}/api/approvals/{{approvalId}}/action
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "action": "REJECT",
  "remarks": "Two venues do not meet accessibility standards. Please revise."
}

###

### Escalate approval
PATCH {{base}}/api/approvals/{{approvalId}}/action
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "action": "ESCALATE",
  "remarks": "Escalating to JS for final decision due to capacity constraints."
}

# ─────────────────────────────────────────────
# MOD-05: FAL ISSUANCE AND DIGITAL CORRESPONDENCE
# ─────────────────────────────────────────────

### Generate FAL for a CS (ASO or SO role)
# @name createFAL
@csUserId = CS_USER_ID_HERE
POST {{base}}/api/fal
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "examId": "{{examId}}",
  "csId": "{{csUserId}}",
  "advanceAmountInPaise": 2500000000
}

###

### List all FALs
GET {{base}}/api/fal
Authorization: Bearer {{token}}

###

### Get single FAL (replace FAL_ID)
@falId = FAL_ID_HERE
GET {{base}}/api/fal/{{falId}}
Authorization: Bearer {{token}}

###

### DS sanctions the FAL (DS role only)
PATCH {{base}}/api/fal/{{falId}}/sanction
Authorization: Bearer {{token}}

###

### CS acknowledges receipt of FAL (CS role only — must be the assigned CS)
PATCH {{base}}/api/fal/{{falId}}/acknowledge
Authorization: Bearer {{token}}

###

### Send a reminder for a FAL (ASO, SO, or US role)
POST {{base}}/api/fal/{{falId}}/reminder
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "FIRST_REMINDER"
}

# ─────────────────────────────────────────────
# MOD-06: ADVANCE CALCULATION AND FINANCIAL MANAGEMENT
# ─────────────────────────────────────────────

### Compute advance for a venue (ASO or SO role)
# @name computeAdvance
POST {{base}}/api/finance/calculate
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "examId": "{{examId}}",
  "venueId": "{{venueId}}",
  "candidateCount": 450
}

###

### Get all advance calculations for an exam
GET {{base}}/api/finance/calculate/{{examId}}
Authorization: Bearer {{token}}

###

### VS or CS submits a bill (VS or CS role)
POST {{base}}/api/finance/bills
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "examId": "{{examId}}",
  "amount": 22500000,
  "type": "HONORARIUM",
  "documentUrl": "https://docs.upsc.gov.in/bills/BILL-2025-001.pdf"
}

###

### List all bills for an exam (US, DS, or JS role)
GET {{base}}/api/finance/bills/{{examId}}
Authorization: Bearer {{token}}

###

### US-Receipt verifies a bill (US role)
@billId = BILL_ID_HERE
PATCH {{base}}/api/finance/bills/{{billId}}/verify
Authorization: Bearer {{token}}

###

### DS approves a bill (DS role)
PATCH {{base}}/api/finance/bills/{{billId}}/approve
Authorization: Bearer {{token}}


# -------------------------------------------------
# MOD-07: FIELD REPORTING PWA
# -------------------------------------------------

### Submit checkpoint (VS/CS/IO role)
POST {{base}}/api/field/checkpoint
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "examId": "{{examId}}",
  "venueId": "{{venueId}}",
  "type": "PRE_EXAM_READINESS",
  "data": { "seatingArranged": true, "cctvOperational": true, "staffPresent": 24 },
  "photoUrls": ["https://cdn.upsc.gov.in/photos/cp1.jpg"],
  "isDrillMode": false
}

###

### Submit checkpoint in DRILL mode (writes to DrillSubmission)
POST {{base}}/api/field/checkpoint
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "examId": "{{examId}}",
  "venueId": "{{venueId}}",
  "type": "EXAM_DAY_GATE_CLOSURE",
  "data": { "gateClosedAt": "09:25", "lateArrivals": 3 },
  "photoUrls": [],
  "isDrillMode": true
}

###

### Get all checkpoints for a venue
GET {{base}}/api/field/checkpoint/{{examId}}/{{venueId}}
Authorization: Bearer {{token}}

###

### VS submits venue readiness checklist
POST {{base}}/api/field/readiness
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "examId": "{{examId}}",
  "venueId": "{{venueId}}",
  "checklistData": { "seatingComplete": true, "invigilatorsPresent": true, "biometricSetup": true },
  "isDrillMode": false
}

###

### Get readiness status for all venues in exam
GET {{base}}/api/field/readiness/{{examId}}
Authorization: Bearer {{token}}

###

### CS reviews a readiness submission
@readinessId = READINESS_ID_HERE
PATCH {{base}}/api/field/readiness/{{readinessId}}/review
Authorization: Bearer {{token}}
Content-Type: application/json

{ "status": "REVIEWED" }

###

### Get drill completion status per VS
GET {{base}}/api/field/drill-status/{{examId}}
Authorization: Bearer {{token}}

# -------------------------------------------------
# MOD-08: MATERIAL TRACKING
# -------------------------------------------------

### Generate PIN and QR for a venue (ASO/SO)
POST {{base}}/api/materials/pin
Authorization: Bearer {{token}}
Content-Type: application/json

{ "examId": "{{examId}}", "venueId": "{{venueId}}" }

###

### List all material pins for an exam
GET {{base}}/api/materials/pin/{{examId}}
Authorization: Bearer {{token}}

###

### VS confirms material receipt
POST {{base}}/api/materials/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "pin": "12345678",
  "eventType": "RECEIVED",
  "quantity": 450,
  "remarks": "All sealed packets received in good condition"
}

###

### Full chain of custody for a venue
GET {{base}}/api/materials/tracking/{{venueId}}/{{examId}}
Authorization: Bearer {{token}}

###

### List all discrepancies for an exam
GET {{base}}/api/materials/discrepancies/{{examId}}
Authorization: Bearer {{token}}

# -------------------------------------------------
# MOD-09: INSPECTION MODULE
# -------------------------------------------------

### Assign IO to venue (US/SO)
@ioUserId = IO_USER_ID_HERE
POST {{base}}/api/inspections
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "examId": "{{examId}}",
  "venueId": "{{venueId}}",
  "ioId": "{{ioUserId}}",
  "scheduledFor": "2026-05-24T10:00:00.000Z",
  "isExamDay": false
}

###

### List all inspections for an exam (SO/US/DS/JS)
GET {{base}}/api/inspections/{{examId}}
Authorization: Bearer {{token}}

###

### IO views their own assigned inspections
GET {{base}}/api/inspections/my
Authorization: Bearer {{token}}

###

### IO submits inspection report (min 5 photos required)
@inspectionId = INSPECTION_ID_HERE
PATCH {{base}}/api/inspections/{{inspectionId}}/submit
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "checklistData": { "sealIntact": true, "cctvCoverage": "100%" },
  "photoUrls": [
    "https://cdn.upsc.gov.in/insp/p1.jpg",
    "https://cdn.upsc.gov.in/insp/p2.jpg",
    "https://cdn.upsc.gov.in/insp/p3.jpg",
    "https://cdn.upsc.gov.in/insp/p4.jpg",
    "https://cdn.upsc.gov.in/insp/p5.jpg"
  ],
  "geoLat": 28.6139,
  "geoLng": 77.2090,
  "findings": "All arrangements in order.",
  "requiresRemediation": false
}

###

### US/SO reviews inspection
PATCH {{base}}/api/inspections/{{inspectionId}}/review
Authorization: Bearer {{token}}
Content-Type: application/json

{ "requiresRemediation": true }

# -------------------------------------------------
# MOD-10: AD-HOC SURVEY
# -------------------------------------------------

### Create and dispatch survey (US/SO)
POST {{base}}/api/surveys
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Post-Exam Infrastructure Feedback 2026",
  "examId": "{{examId}}",
  "questions": [
    { "id": "q1", "text": "Was CCTV functional throughout?", "type": "boolean" },
    { "id": "q2", "text": "Seating utilisation (%)", "type": "number" },
    { "id": "q3", "text": "Any issues encountered?", "type": "text" }
  ],
  "recipientRoles": ["VS", "CS"],
  "recipientCities": ["Delhi NCR", "Mumbai"],
  "deadline": "2026-06-30T23:59:59.000Z"
}

###

### List all surveys (US/SO/DS/JS)
GET {{base}}/api/surveys
Authorization: Bearer {{token}}

###

### VS/CS/IO views their assigned surveys
GET {{base}}/api/surveys/my
Authorization: Bearer {{token}}

###

### Submit survey response
@surveyId = SURVEY_ID_HERE
POST {{base}}/api/surveys/{{surveyId}}/respond
Authorization: Bearer {{token}}
Content-Type: application/json

{ "answers": { "q1": true, "q2": 92, "q3": "Minor delay resolved in 5 minutes." }, "isDraft": false }

###

### Get all responses with completion stats
GET {{base}}/api/surveys/{{surveyId}}/responses
Authorization: Bearer {{token}}

###

### Get response rate and per-question aggregation
GET {{base}}/api/surveys/{{surveyId}}/stats
Authorization: Bearer {{token}}

# -------------------------------------------------
# MOD-11: FACE AUTH
# -------------------------------------------------

### Batch ingest face auth data (ASO system integration)
POST {{base}}/api/faceauth/ingest
Authorization: Bearer {{token}}
Content-Type: application/json

[
  { "examId": "{{examId}}", "venueId": "{{venueId}}", "candidateRollNo": "0001234", "matchConfidence": 94.5, "matchResult": "MATCH" },
  { "examId": "{{examId}}", "venueId": "{{venueId}}", "candidateRollNo": "0001235", "matchConfidence": 42.1, "matchResult": "INCONCLUSIVE" },
  { "examId": "{{examId}}", "venueId": "{{venueId}}", "candidateRollNo": "0001236", "matchConfidence": null, "matchResult": "NO_MATCH" }
]

###

### Get flagged records for forensic review (US/DS/JS)
GET {{base}}/api/faceauth/flags/{{examId}}
Authorization: Bearer {{token}}

###

### Review a flagged case (US/DS)
@faceAuthId = FACE_AUTH_ID_HERE
PATCH {{base}}/api/faceauth/{{faceAuthId}}/review
Authorization: Bearer {{token}}
Content-Type: application/json

{ "caseStatus": "UNDER_INVESTIGATION", "reviewNotes": "Forwarding to IS Wing." }

###

### VS/IO/CS confirms jammer status
POST {{base}}/api/faceauth/jammer
Authorization: Bearer {{token}}
Content-Type: application/json

{ "examId": "{{examId}}", "venueId": "{{venueId}}", "jammerId": "JAMMER-UNIT-07", "isActive": true }

###

### Get jammer status for all venues
GET {{base}}/api/faceauth/jammer/{{examId}}
Authorization: Bearer {{token}}

# -------------------------------------------------
# MOD-12: COCKPIT AND MIS
# -------------------------------------------------

### Real-time exam status dashboard (US/DS/JS)
GET {{base}}/api/cockpit/exam-status/{{examId}}
Authorization: Bearer {{token}}

###

### Team workload — pending actions (SO/US/DS/JS)
GET {{base}}/api/cockpit/team-workload
Authorization: Bearer {{token}}

###

### Active alerts for an exam (US/DS/JS)
GET {{base}}/api/cockpit/alerts/{{examId}}
Authorization: Bearer {{token}}

###

### Send priority notification to a VS or CS (US/DS/JS)
@targetUserId = TARGET_USER_ID_HERE
POST {{base}}/api/cockpit/notify
Authorization: Bearer {{token}}
Content-Type: application/json

{ "targetUserId": "{{targetUserId}}", "message": "Submit venue readiness checklist immediately.", "examId": "{{examId}}" }

###

### Attendance report
GET {{base}}/api/reports/attendance/{{examId}}
Authorization: Bearer {{token}}

###

### Financial summary
GET {{base}}/api/reports/financial/{{examId}}
Authorization: Bearer {{token}}

###

### Venue readiness by city
GET {{base}}/api/reports/venue-status/{{examId}}
Authorization: Bearer {{token}}

###

### Inspection completion and findings
GET {{base}}/api/reports/inspection-summary/{{examId}}
Authorization: Bearer {{token}}

###

### Chain of custody summary per venue
GET {{base}}/api/reports/material-tracking/{{examId}}
Authorization: Bearer {{token}}
