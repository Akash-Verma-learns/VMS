generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JS
  DS
  US
  SO
  ASO
  CS
  VS
  IO
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String
  role      Role
  cityName  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  // MOD-01
  sessions  Session[]
  auditLogs AuditLog[]
  // MOD-02
  exams     Exam[]
  // MOD-03
  venues               Venue[]
  venueAssignmentsAsVS VenueAssignment[]    @relation("VenueAssignmentVS")
  venueAssignmentsAsCS VenueAssignment[]    @relation("VenueAssignmentCS")
  // MOD-04
  approvalRequests     ApprovalRequest[]    @relation("ApprovalInitiator")
  approvalAudits       ApprovalAudit[]
  // MOD-05
  falAsCS              FAL[]                @relation("FALcs")
  falSanctioned        FAL[]                @relation("FALsanctioned")
  // MOD-06
  advanceCalculations  AdvanceCalculation[]
  billsSubmitted       Bill[]               @relation("BillSubmitter")
  billsVerified        Bill[]               @relation("BillVerifier")
  fieldReports          FieldReport[]
  // MOD-07
  checkpointSubmissions CheckpointSubmission[]
  drillSubmissions      DrillSubmission[]
  venueReadinessReports VenueReadiness[]
  // MOD-08
  materialTrackingEvents MaterialTracking[]
  // MOD-09
  inspectionsAsIO      Inspection[]         @relation("InspectionIO")
  inspectionsAssigned  Inspection[]         @relation("InspectionAssigner")
  // MOD-10
  surveysCreated       Survey[]             @relation("SurveyCreator")
  surveyResponses      SurveyResponse[]
  // MOD-11
  faceAuthReviews      FaceAuthRecord[]
  jammerConfirmations  JammerStatus[]
  releasedAllocations SeatAllocation[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model OtpToken {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

// MOD-02: Exam Creation and Centre Management
model Exam {
  id            String     @id @default(uuid())
  name          String
  examCode      String     @unique
  year          Int
  examType      ExamType
  scheduledDate DateTime
  sessions      Int        @default(1)
  session1Start String?
  session1End   String?
  session2Start String?
  session2End   String?
  status        ExamStatus @default(DRAFT)
  createdById   String
  createdBy     User       @relation(fields: [createdById], references: [id])
  centres              Centre[]
  assignments          VenueAssignment[]
  approvalRequests     ApprovalRequest[]
  candidatePreferences CandidatePreference[]
  fals                FAL[]
  advanceCalculations AdvanceCalculation[]
  bills               Bill[]
  // MOD-07
  checkpointSubmissions CheckpointSubmission[]
  drillSubmissions      DrillSubmission[]
  venueReadinessReports VenueReadiness[]
  // MOD-08
  materialPins     MaterialPin[]
  // MOD-09
  inspections      Inspection[]
  // MOD-10
  surveys          Survey[]
  // MOD-11
  faceAuthRecords  FaceAuthRecord[]
  jammerStatuses   JammerStatus[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  seatAllocations     SeatAllocation[]
}

model Centre {
  id                String    @id @default(uuid())
  examId            String
  exam              Exam      @relation(fields: [examId], references: [id])
  cityName          String
  suggestedCapacity Int
  finalCapacity     Int?
  isReleased        Boolean   @default(false)
  releasedAt        DateTime?
  createdAt         DateTime  @default(now())
}

enum ExamType {
  PRELIMINARY
  MAINS
  INTERVIEW
}

enum ExamStatus {
  DRAFT
  PENDING_SO
  PENDING_US
  RELEASED
}

enum VenueStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// MOD-03: Venue Identification and Selection
model Venue {
  id             String      @id @default(uuid())
  name           String
  address        String
  cityName       String
  type           VenueType
  capacity       Int
  isActive       Boolean     @default(true)
  approvalStatus VenueStatus @default(APPROVED)
  rejectionNote  String?
  addedById      String
  addedBy        User        @relation(fields: [addedById], references: [id])
  assignments         VenueAssignment[]
  advanceCalculations AdvanceCalculation[]
  fieldReports          FieldReport[]
  // MOD-07
  checkpointSubmissions CheckpointSubmission[]
  drillSubmissions      DrillSubmission[]
  venueReadinessReports VenueReadiness[]
  // MOD-08
  materialPins     MaterialPin[]
  // MOD-09
  inspections      Inspection[]
  // MOD-11
  faceAuthRecords  FaceAuthRecord[]
  jammerStatuses   JammerStatus[]
  createdAt   DateTime  @default(now())
  seatAllocations       SeatAllocation[]
}

model VenueAssignment {
  id               String           @id @default(uuid())
  examId           String
  exam             Exam             @relation(fields: [examId], references: [id])
  venueId          String
  venue            Venue            @relation(fields: [venueId], references: [id])
  vsId             String?
  vs               User?            @relation("VenueAssignmentVS", fields: [vsId], references: [id])
  csId             String
  cs               User             @relation("VenueAssignmentCS", fields: [csId], references: [id])
  seatsAllocated   Int?
  status           AssignmentStatus @default(PROPOSED)
  rejectionComment String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([examId, status])
  @@index([csId])
}

enum VenueType {
  GOVERNMENT
  AIDED
  PRIVATE
  UNIVERSITY
}

enum AssignmentStatus {
  PROPOSED
  SUBMITTED
  SO_REVIEWED
  APPROVED
  REJECTED
}

// MOD-04: Administrative Approval and Workflow
model ApprovalRequest {
  id           String         @id @default(uuid())
  examId       String
  exam         Exam           @relation(fields: [examId], references: [id])
  type         ApprovalType
  status       ApprovalStatus @default(PENDING)
  initiatedBy  String
  initiator    User           @relation("ApprovalInitiator", fields: [initiatedBy], references: [id])
  currentRole  Role
  dueAt        DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  auditEntries ApprovalAudit[]
}

model ApprovalAudit {
  id        String          @id @default(uuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id])
  actorId   String
  actor     User            @relation(fields: [actorId], references: [id])
  action    String
  remarks   String?
  createdAt DateTime        @default(now())
}

enum ApprovalType {
  VENUE_LIST
  FAL_SANCTION
  BILL_SETTLEMENT
  ADVANCE_CALCULATION
}

enum ApprovalStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  ESCALATED
}

// MOD-05: FAL Issuance and Digital Correspondence
model FAL {
  id             String    @id @default(uuid())
  examId         String
  exam           Exam      @relation(fields: [examId], references: [id])
  csId           String
  cs             User      @relation("FALcs", fields: [csId], references: [id])
  falNumber      String    @unique
  advanceAmount  BigInt
  issuedAt       DateTime?
  deliveredAt    DateTime?
  acknowledgedAt DateTime?
  status         FALStatus @default(DRAFT)
  sanctionedById String?
  sanctionedBy   User?     @relation("FALsanctioned", fields: [sanctionedById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reminders      FALReminder[]
}

model FALReminder {
  id     String   @id @default(uuid())
  falId  String
  fal    FAL      @relation(fields: [falId], references: [id])
  sentAt DateTime @default(now())
  type   String
}

enum FALStatus {
  DRAFT
  PENDING_DS
  SANCTIONED
  ISSUED
  ACKNOWLEDGED
  OVERDUE
}

// MOD-06: Advance Calculation and Financial Management
model AdvanceCalculation {
  id             String   @id @default(uuid())
  examId         String
  exam           Exam     @relation(fields: [examId], references: [id])
  venueId        String
  venue          Venue    @relation(fields: [venueId], references: [id])
  candidateCount Int
  honorarium     BigInt
  stationery     BigInt
  contingency    BigInt
  totalAmount    BigInt
  computedAt     DateTime @default(now())
  computedById   String
  computedBy     User     @relation(fields: [computedById], references: [id])
}

model Bill {
  id          String     @id @default(uuid())
  examId      String
  exam        Exam       @relation(fields: [examId], references: [id])
  submittedBy String
  submitter   User       @relation("BillSubmitter", fields: [submittedBy], references: [id])
  amount      BigInt
  type        BillType
  status      BillStatus @default(SUBMITTED)
  documentUrl String?
  verifiedBy  String?
  verifier    User?      @relation("BillVerifier", fields: [verifiedBy], references: [id])
  verifiedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum BillType {
  HONORARIUM
  STATIONERY
  CONTINGENCY
  OTHER
}

enum BillStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  APPROVED
  REJECTED
}

// MOD-07: Field Reporting (initial schema)
model FieldReport {
  id          String       @id
  venueId     String
  venue       Venue        @relation(fields: [venueId], references: [id])
  submittedBy String
  submitter   User         @relation(fields: [submittedBy], references: [id])
  isDrill     Boolean      @default(false)
  reportType  ReportType
  data        Json
  deviceTime  DateTime
  serverTime  DateTime     @default(now())
  photos      FieldPhoto[]
}

model FieldPhoto {
  id            String      @id @default(uuid())
  fieldReportId String
  fieldReport   FieldReport @relation(fields: [fieldReportId], references: [id])
  photoUrl      String
  latitude      Float?
  longitude     Float?
  capturedAt    DateTime
}

enum ReportType {
  PRE_EXAM_READINESS
  EXAM_DAY_GATE_CLOSURE
  SESSION_START
  MATERIAL_DISPATCH
}


// MOD-07: Field Reporting PWA Backend
model CheckpointSubmission {
  id          String         @id @default(uuid())
  examId      String
  exam        Exam           @relation(fields: [examId], references: [id])
  venueId     String
  venue       Venue          @relation(fields: [venueId], references: [id])
  submittedBy String
  submitter   User           @relation(fields: [submittedBy], references: [id])
  type        CheckpointType
  data        Json
  photoUrls   String[]
  isDrillMode Boolean        @default(false)
  syncedAt    DateTime       @default(now())
  createdAt   DateTime       @default(now())
}

model DrillSubmission {
  id          String         @id @default(uuid())
  examId      String
  exam        Exam           @relation(fields: [examId], references: [id])
  venueId     String
  venue       Venue          @relation(fields: [venueId], references: [id])
  submittedBy String
  submitter   User           @relation(fields: [submittedBy], references: [id])
  type        CheckpointType
  data        Json
  photoUrls   String[]
  createdAt   DateTime       @default(now())
}

model VenueReadiness {
  id            String          @id @default(uuid())
  examId        String
  exam          Exam            @relation(fields: [examId], references: [id])
  venueId       String
  venue         Venue           @relation(fields: [venueId], references: [id])
  vsId          String
  vs            User            @relation(fields: [vsId], references: [id])
  status        ReadinessStatus @default(PENDING)
  checklistData Json?
  submittedAt   DateTime?
  isDrillMode   Boolean         @default(false)
  createdAt     DateTime        @default(now())
}

enum CheckpointType {
  PRE_EXAM_READINESS
  ARRANGEMENT_DAY
  EXAM_DAY_GATE_CLOSURE
  EXAM_DAY_SECURITY
  EXAM_DAY_PAPER_OPENING
  EXAM_DAY_SESSION_START
  EXAM_DAY_SESSION_END
  EXAM_DAY_ATTENDANCE
  POST_EXAM_DISPATCH
  CCTV_ARCHIVAL_CONFIRMATION
  BIOMETRIC_CONFIRMATION
}

enum ReadinessStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  FLAGGED
}

// MOD-08: Material Tracking Backend
model MaterialPin {
  id              String             @id @default(uuid())
  examId          String
  exam            Exam               @relation(fields: [examId], references: [id])
  venueId         String
  venue           Venue              @relation(fields: [venueId], references: [id])
  pin             String             @unique
  qrCode          String             @unique
  isActive        Boolean            @default(true)
  omrCount        Int                @default(0)
  salCount        Int                @default(0)
  stationeryCount Int                @default(0)
  createdAt       DateTime           @default(now())
  trackingEvents  MaterialTracking[]
}

model MaterialTracking {
  id          String        @id @default(uuid())
  pinId       String
  pin         MaterialPin   @relation(fields: [pinId], references: [id])
  eventType   TrackingEvent
  confirmedBy String
  confirmer   User          @relation(fields: [confirmedBy], references: [id])
  quantity    Int?
  remarks     String?
  discrepancy Boolean       @default(false)
  createdAt   DateTime      @default(now())
}

enum TrackingEvent {
  DISPATCHED
  RECEIVED
  DISCREPANCY_REPORTED
  POST_EXAM_DISPATCHED
  CONFIRMED
}

// MOD-09: Inspection Module Backend
model Inspection {
  id                  String           @id @default(uuid())
  examId              String
  exam                Exam             @relation(fields: [examId], references: [id])
  venueId             String
  venue               Venue            @relation(fields: [venueId], references: [id])
  ioId                String
  io                  User             @relation("InspectionIO", fields: [ioId], references: [id])
  assignedBy          String
  assigner            User             @relation("InspectionAssigner", fields: [assignedBy], references: [id])
  scheduledFor        DateTime?
  isExamDay           Boolean          @default(false)
  status              InspectionStatus @default(ASSIGNED)
  checklistData       Json?
  photoUrls           String[]
  geoLat              Float?
  geoLng              Float?
  submittedAt         DateTime?
  findings            String?
  requiresRemediation Boolean          @default(false)
  createdAt           DateTime         @default(now())
}

enum InspectionStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  REMEDIATION_REQUIRED
}

// MOD-10: Ad-hoc Survey Backend
model Survey {
  id               String         @id @default(uuid())
  title            String
  examId           String?
  exam             Exam?          @relation(fields: [examId], references: [id])
  createdBy        String
  creator          User           @relation("SurveyCreator", fields: [createdBy], references: [id])
  questions        Json
  recipientRoles   String[]
  recipientCities  String[]
  deadline         DateTime
  status           SurveyStatus   @default(ACTIVE)
  createdAt        DateTime       @default(now())
  responses        SurveyResponse[]
}

model SurveyResponse {
  id          String   @id @default(uuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id])
  responderId String
  responder   User     @relation(fields: [responderId], references: [id])
  answers     Json
  submittedAt DateTime @default(now())
  isDraft     Boolean  @default(false)
}

enum SurveyStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

// MOD-11: Face Auth Backend
model FaceAuthRecord {
  id              String     @id @default(uuid())
  examId          String
  exam            Exam       @relation(fields: [examId], references: [id])
  venueId         String
  venue           Venue      @relation(fields: [venueId], references: [id])
  candidateRollNo String
  matchConfidence Float?
  matchResult     AuthResult
  flagged         Boolean    @default(false)
  flagReason      String?
  ingestedAt      DateTime   @default(now())
  reviewedBy      String?
  reviewer        User?      @relation(fields: [reviewedBy], references: [id])
  reviewedAt      DateTime?
  caseStatus      CaseStatus @default(PENDING_REVIEW)

  @@index([examId, flagged])
  @@index([examId, caseStatus])
}

model JammerStatus {
  id          String   @id @default(uuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id])
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id])
  jammerId    String
  isActive    Boolean  @default(false)
  confirmedBy String
  confirmer   User     @relation(fields: [confirmedBy], references: [id])
  confirmedAt DateTime @default(now())
}

enum AuthResult {
  MATCH
  NO_MATCH
  INCONCLUSIVE
  NOT_CAPTURED
}

enum CaseStatus {
  PENDING_REVIEW
  UNDER_INVESTIGATION
  CLOSED_LEGITIMATE
  CLOSED_MALPRACTICE
  ESCALATED
}

// MOD-12: Candidate City Preferences
enum AllocationStatus {
  DRAFT     // allotted internally, invisible to candidates
  RELEASED  // admit card published and downloadable
}

/// One candidate's venue + seat for one exam.
///
/// Allotment is driven by the city preferences the candidate submitted on the
/// public form: priority1 is tried first, then priority2, and so on, falling
/// through to the next choice whenever a city has no seats left. The rank that
/// was actually satisfied is recorded so the allotment can be explained.
model SeatAllocation {
  id             String           @id @default(uuid())
  examId         String
  exam           Exam             @relation(fields: [examId], references: [id])
  rollNo         String
  candidateName  String?
  venueId        String?
  venue          Venue?           @relation(fields: [venueId], references: [id])
  allottedCity   String?
  seatNo         String?
  /// Which preference was met (1-5); null when nothing could be allotted.
  preferenceRank Int?
  status         AllocationStatus @default(DRAFT)
  allocatedAt    DateTime         @default(now())
  releasedAt     DateTime?
  releasedBy     String?
  releaser       User?            @relation(fields: [releasedBy], references: [id])

  @@unique([examId, rollNo])
  @@index([examId, status])
  @@index([venueId, status])
}

model CandidatePreference {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  rollNo        String
  candidateName String?
  priority1     String
  priority2     String?
  priority3     String?
  priority4     String?
  priority5     String?
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([examId, rollNo])
  @@index([examId])
}
