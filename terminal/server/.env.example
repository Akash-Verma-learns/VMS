# Copy to .env and fill in. Every value can also be exported as a shell env var.

# VMS backend (apps/api)
VMS_BASE_URL=http://localhost:3001

# ASO bearer token. Log in as an ASO, read the OTP from the API terminal,
# then copy `token` from the verify-otp response (DevTools -> Network, or localStorage).
# Lifetime is 8 hours, and the VMS allows ONE session per user -- see README.
VMS_JWT=

# UUIDs of the seeded demo exam and venue. Both are enforced foreign keys:
# a wrong value makes every ingest fail with a 500.
VMS_EXAM_ID=
VMS_VENUE_ID=

# Set to 1 to decide locally and skip VMS logging entirely (offline demo mode).
GATE_OFFLINE=0

# Raspberry Pi Zero 2 capture endpoint. Leave empty to run the gate on
# fingerprint alone; set it to enable the second biometric factor.
CAM_URL=http://192.168.1.50:8080/capture
